# Copy this file to .env.local and fill in your actual values

# Supabase Configuration
# Get these from: https://app.supabase.com/project/your-project/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Anthropic AI Configuration (server-only)
# Get this from: https://console.anthropic.com/
# Note: the app reads APP_ANTHROPIC_KEY (not the more common ANTHROPIC_API_KEY
# name) — all AI routes (brew-recipe, roast-planning, roast-profile,
# bean-analysis, invoice-processing) standardized on this name.
APP_ANTHROPIC_KEY=your_anthropic_api_key_here